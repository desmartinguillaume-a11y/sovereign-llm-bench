# Copy this file to .env and fill in your keys.
# Keys are only needed for --validate (live API quality spot-check).
# TCO computation runs without any API keys.

MISTRAL_API_KEY=your_mistral_key_here

ANTHROPIC_API_KEY=your_anthropic_key_here

AZURE_OPENAI_API_KEY=your_azure_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-01

# vLLM endpoint URL for OVH self-hosted instance
OVH_INFERENCE_BASE_URL=http://your-ovh-instance-ip:8000/v1
